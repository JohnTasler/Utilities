<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>false</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>latest</LangVersion>
		<ApplicationIcon>View\Images\Application.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <ApplicationDefinition Remove="App.xaml" />
	  <None Remove="View\Cursors\Locate.cur" />
	  <None Remove="View\Cursors\Select.cur" />
	  <None Remove="View\Images\Position.ico" />
	  <None Remove="View\Images\refresh_icon.png" />
	  <None Remove="View\Images\Selection.ico" />
	  <None Remove="View\Images\ZoomIn-16.png" />
	  <None Remove="View\Images\ZoomOut-16.png" />
	</ItemGroup>

	<ItemGroup>
	  <Page Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="View\Cursors\Locate.cur" />
	  <Resource Include="View\Cursors\Select.cur" />
	  <Resource Include="View\Images\Application.ico" />
	  <Resource Include="View\Images\Position.ico" />
	  <Resource Include="View\Images\refresh_icon.png" />
	  <Resource Include="View\Images\Selection.ico" />
	  <Resource Include="View\Images\ZoomIn-16.png" />
	  <Resource Include="View\Images\ZoomOut-16.png" />
	</ItemGroup>

</Project>
